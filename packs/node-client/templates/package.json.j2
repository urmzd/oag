{
  "name": "{{ scaffold.package_name or '' }}",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
{% if scaffold.repository %}
  "repository": {
    "type": "git",
    "url": "{{ scaffold.repository }}"
  },
{% endif %}
  "scripts": {
{% if scaffold.bundler == 'tsdown' %}
    "build": "tsdown",
{% endif %}
{% if scaffold.formatter == 'biome' %}
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
{% endif %}
{% if scaffold.test_runner %}
    "test": "{{ scaffold.test_runner }} run",
{% endif %}
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
{%- if scaffold.react %}
    "react": "^19.0.0",
    "swr": "^2.2.0"
{%- endif %}
  },
  "devDependencies": {
{%- if scaffold.formatter == 'biome' %}
    "@biomejs/biome": "^2.4.0",
{%- endif %}
{%- if scaffold.react %}
    "@types/react": "^19.0.0",
{%- endif %}
{%- if scaffold.bundler == 'tsdown' %}
    "tsdown": "^0.12.0",
{%- endif %}
{%- if scaffold.test_runner == 'vitest' %}
    "vitest": "^3.0.0",
{%- endif %}
{%- if scaffold.extra_dev_dependencies %}
{%- for pkg, ver in scaffold.extra_dev_dependencies|items %}
    "{{ pkg }}": "{{ ver }}",
{%- endfor %}
{%- endif %}
    "typescript": "^5.7.0"
  }
}
